# Real, working reverse-proxy + automatic HTTPS config — not a stub.
# Caddy requests and renews Let's Encrypt certificates for these two
# domains entirely on its own; the only manual step is pointing DNS at
# this host and setting the two env vars below before `docker compose up`.
# See docs/deployment/README.md for the full walkthrough.
#
# Required env vars (set in .env.production, never committed):
#   API_DOMAIN=api.yourcompany.com
#   APP_DOMAIN=dispatch.yourcompany.com     <- staff board
#   SITE_DOMAIN=yourcompany.com             <- public site (optional)
#
# APP_DOMAIN and SITE_DOMAIN both proxy to the same container; the app
# decides which face to serve from the hostname (see src/utils/surface.ts),
# so a host called "dispatch" gets the board at its root and the apex gets
# the customer site.

{$API_DOMAIN} {
	reverse_proxy router:5000

	# Socket.IO's websocket upgrade needs the same proxy target — Caddy
	# handles the Upgrade/Connection headers automatically for
	# reverse_proxy, this just documents that it's covered, not a gap.
	encode gzip
}

{$APP_DOMAIN} {
	reverse_proxy ui:80
	encode gzip
}

# The public site. Optional: until SITE_DOMAIN's DNS points here, leave it
# unset and Caddy skips this block rather than failing to start — the
# customer pages stay reachable on APP_DOMAIN in the meantime.
{$SITE_DOMAIN:localhost.invalid} {
	reverse_proxy ui:80
	encode gzip
}

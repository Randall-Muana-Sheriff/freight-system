# Real, working reverse-proxy + automatic HTTPS config — not a stub.
# Caddy requests and renews Let's Encrypt certificates for these two
# domains entirely on its own; the only manual step is pointing DNS at
# this host and setting the two env vars below before `docker compose up`.
# See docs/deployment/README.md for the full walkthrough.
#
# Required env vars (set in .env.production, never committed):
#   API_DOMAIN=api.yourcompany.com
#   APP_DOMAIN=dispatch.yourcompany.com     <- staff board
#   SITE_DOMAIN=yourcompany.com             <- public site (optional)
#
# APP_DOMAIN and SITE_DOMAIN both proxy to the same container; the app
# decides which face to serve from the hostname (see src/utils/surface.ts),
# so a host called "dispatch" gets the board at its root and the apex gets
# the customer site.

# Sent on every HTTPS response below. Without it, a visitor who types the
# bare hostname or follows an http:// link makes one unencrypted request
# before the 308 redirect fires, and that first request is interceptable on
# a shared or hostile network — a redirect cannot protect the hop that
# triggers it. HSTS tells the browser never to make that request again.
#
# Deliberately no includeSubDomains and no preload. Both are effectively
# one-way doors: preload requires a removal request and months of browser
# release cycles to undo, and includeSubDomains would bind every future
# subdomain — a staging or partner host on plain http would simply be
# unreachable, with a browser-cached error and no server-side fix. The
# apex, the API and the board are all already HTTPS-only and auto-renewing
# here, so the narrow form buys the protection without the trap.
#
# To back this out, lower max-age to 0 and leave it deployed until the old
# value has aged out of visitors' browsers. Removing the header alone does
# nothing — browsers keep honouring the last value they saw.
(security_headers) {
	header Strict-Transport-Security "max-age=31536000"
}

{$API_DOMAIN} {
	# No `import security_headers` here on purpose. The router sets HSTS
	# itself via helmet, with includeSubDomains, and adding Caddy's on top
	# sent two Strict-Transport-Security headers with different values —
	# legal, but a browser takes the first and a reader cannot tell which
	# one is in force. The API is the one host that already covers itself.
	reverse_proxy router:5000

	# Socket.IO's websocket upgrade needs the same proxy target — Caddy
	# handles the Upgrade/Connection headers automatically for
	# reverse_proxy, this just documents that it's covered, not a gap.
	encode gzip
}

{$APP_DOMAIN} {
	import security_headers
	reverse_proxy ui:80
	encode gzip
}

# The public site. Optional: until SITE_DOMAIN's DNS points here, leave it
# unset and Caddy skips this block rather than failing to start — the
# customer pages stay reachable on APP_DOMAIN in the meantime.
{$SITE_DOMAIN:localhost.invalid} {
	import security_headers
	reverse_proxy ui:80
	encode gzip
}

# One canonical home for the public site. Serving it on both the apex and
# www would show search engines two copies of every page; a redirect keeps
# the ranking on one address.
www.{$SITE_DOMAIN:localhost.invalid} {
	redir https://{$SITE_DOMAIN:localhost.invalid}{uri} permanent
}

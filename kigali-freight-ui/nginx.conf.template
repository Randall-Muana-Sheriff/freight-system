server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers for the static dashboard bundle.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # __API_CONNECT_SRC__ is substituted by docker-entrypoint.sh at
    # container start from the API_BASE_URL env var (ws/wss + http/https
    # variants of that origin) — the backend URL isn't known until runtime
    # (same reason /config.js exists), so it can't be hardcoded here.
    # style-src needs 'unsafe-inline': Leaflet positions every marker via
    # inline `style="transform:..."` attributes, not stylesheet classes.
    # img-src includes *.r2.cloudflarestorage.com for driver document /
    # delivery-photo previews — those are signed URLs pointing directly at
    # R2's S3-compatible endpoint (see toSignedUrl in r2Client.js), not
    # same-origin, so without this the browser blocks every one of them
    # (a CSP violation logged to the browser console, but the <img>
    # itself just renders blank with no visible error in the UI).
    # connect-src includes api.open-meteo.com: the kiosk display's weather
    # widget (src/kiosk/weather.ts) calls Open-Meteo directly from the
    # browser — it's free and keyless, so there's no backend proxy for it.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://*.tile.openstreetmap.org https://*.r2.cloudflarestorage.com; font-src 'self'; connect-src 'self' __API_CONNECT_SRC__ https://api.open-meteo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # One container serves both the public site and the staff board, told
    # apart by hostname. The staff host must not be crawled at all, so it
    # gets its own robots.txt rather than the permissive one generated for
    # the public host.
    location = /robots.txt {
        if ($http_host ~* "^(dispatch|admin|ops)\\.") {
            rewrite ^ /robots-staff.txt last;
        }
    }

    location / {
        # Client-side routing fallback for the React SPA.
        try_files $uri $uri/ /index.html;
    }

    # index.html is the one file that must never be held. Everything in the
    # asset block below is content-hashed and immutable for a week, which is
    # right — but that scheme only works if the document naming those hashes
    # is always fresh. Served with no Cache-Control at all, as this was, a
    # browser falls back to heuristic freshness and may keep an index.html
    # from a previous deploy; it then resolves the old hashed filenames
    # straight out of its own immutable cache and never asks the server for
    # anything. The visitor is pinned to the last release with no signal that
    # a new one exists, and no fix short of a hard refresh.
    #
    # `expires` rather than `add_header Cache-Control`, deliberately. nginx
    # drops the entire inherited add_header set the moment a location
    # declares one of its own — that is why the asset block below answers
    # with no CSP, no X-Frame-Options and no nosniff at all today. Using
    # add_header here would silently strip those four headers from the main
    # document, which is a much worse bug than the one this fixes. `expires`
    # is a different directive and triggers none of that, so the server-level
    # headers still apply. `expires -1` emits Cache-Control: no-cache, which
    # means revalidate-before-use rather than never-store: the ETag above
    # makes that a 304 on the common path, so the cost is one conditional
    # request per navigation, not a re-download.
    location = /index.html {
        expires -1;
    }

    location = /config.js {
        # Generated fresh by docker-entrypoint.sh from the container's
        # actual env on every start — never cache it like the other
        # static assets below.
        add_header Cache-Control "no-store" always;
    }

    location ~* \.(?:css|js|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}

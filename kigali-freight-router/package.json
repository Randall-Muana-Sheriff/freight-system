{
  "name": "inzira-router",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "echo 'router: nothing to build'",
    "dev": "nodemon --import ./instrument.js server.js",
    "start": "node --import ./instrument.js server.js",
    "lint": "eslint . --ext .js",
    "typecheck": "echo 'router: no typecheck'",
    "test": "node --test tests/routeSequencing.test.js tests/customerNotification.test.js tests/redaction.test.js tests/migrationCoverage.test.js tests/pricing.test.js tests/marketTime.test.js tests/phone.test.js tests/placeHints.test.js tests/payments.test.js tests/orderTransitions.test.js tests/money.test.js tests/authMiddleware.test.js",
    "test:integration": "npm run db:migrate && node --test tests/integration.test.js",
    "docker:build": "docker build -f Dockerfile -t kigali-freight-router ..",
    "db:migrate": "node bin/migrate.js",
    "seed:demo": "node ops/seed-demo-data.js",
    "seed:demo:clear": "node ops/seed-demo-data.js --clear",
    "review:driver": "node ops/create-review-driver.js",
    "review:driver:remove": "node ops/create-review-driver.js --remove",
    "build:info": "node bin/write-build-info.js",
    "db:migrate:down": "node bin/migrate-down.js",
    "backup:db": "node ops/backup-db.js",
    "backup:offsite": "node ops/upload-backup-offsite.js",
    "restore:db": "node ops/restore-db.js",
    "backup:verify": "node ops/verify-backup.js",
    "backup:prune": "node ops/prune-backups.js",
    "load:test": "node ops/load-test.js",
    "purge:auth-codes": "node ops/purge-expired-auth-codes.js",
    "purge:location-history": "node ops/purge-location-history.js",
    "watchdog": "node ops/watchdog.js",
    "check:prices": "node ops/check-published-prices.js",
    "check:fleet-capacity": "node ops/check-fleet-capacity.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@sentry/node": "^10.70.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "africastalking": "^0.8.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.11",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@freight/config": "*",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}

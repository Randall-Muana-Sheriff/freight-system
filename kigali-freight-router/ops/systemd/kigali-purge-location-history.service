[Unit]
Description=Enforce the retention limit on driver location history
After=network-online.target

[Service]
Type=oneshot
# Adjust to wherever the router is actually deployed on the real host.
WorkingDirectory=/opt/kigali-freight/kigali-freight-router
EnvironmentFile=/opt/kigali-freight/kigali-freight-router/.env
ExecStart=/usr/bin/npm run purge:location-history

[Install]
WantedBy=multi-user.target

PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=kigali_freight_coop

JWT_SECRET=replace_with_a_strong_secret

# Optional: bcrypt work factor for password/PIN hashing. Defaults to 10.
BCRYPT_COST=10

# Optional: self-signup only ever creates 'driver' accounts, so a fresh
# database has no admin and no way to create one through the API. Set both
# to have bin/migrate.js create one admin account (a no-op once any admin
# exists). Leave unset to skip and create the first admin manually instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: static bearer token required on GET /metrics (Prometheus scrape
# configs use a static token, not a short-lived user JWT). Leave unset to
# keep /metrics closed.
METRICS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Keep unset in shared/prod environments.
ALLOW_DESTRUCTIVE_BASELINE=0

# Optional: allows simulator nodes to skip JWT auth on the telemetry socket
# when they present this exact value. Leave unset to disable the bypass.
SIMULATOR_SHARED_SECRET=

# Optional: set to enable horizontal scaling (shared rate limiting, shared
# live-fleet/geofence state, a durable telemetry queue, and the Socket.IO
# Redis adapter for running multiple instances). Leave unset for local dev.
REDIS_URL=

# Optional: absolute path to a Firebase service account JSON file. Enables
# push notifications (e.g. "new delivery assigned") to the driver mobile app
# via Firebase Cloud Messaging. Leave unset to disable push sending.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: Africa's Talking credentials, used to text OTP codes and driver
# invite codes to +250 numbers. Leave unset to have services/smsService.js
# log the code to the server console instead of sending it — useful for
# testing the whole driver auth flow before a real account exists.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Optional: Cloudflare R2 (S3-compatible) credentials for proof-of-delivery
# photos and driver compliance documents. Leave unset to disable upload
# (a clear 503 is returned instead of crashing). R2_ENDPOINT overrides the
# derived https://<accountId>.r2.cloudflarestorage.com endpoint — set it to
# point at a local MinIO instance for dev instead of real R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket is private — every download URL is short-lived and signed
# (see config/r2Client.js's toSignedUrl). This must be the host a browser
# or phone can actually reach the storage service at, which may differ
# from R2_ENDPOINT (e.g. R2_ENDPOINT is the docker-network "minio"
# hostname, but this is a LAN IP or public domain).
R2_PUBLIC_URL_BASE=

package __PACKAGE__

import android.content.Context
import android.content.Intent
import android.os.Build
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod

// Thin JS-facing bridge for LocationForegroundService. Deliberately holds
// no logic: everything that matters runs inside the service so it survives
// the JS engine being torn down, which is the entire point of moving off
// expo-location's background task.
class LocationServiceModule(reactContext: ReactApplicationContext) :
    ReactContextBaseJavaModule(reactContext) {

    override fun getName() = "InziraLocationService"

    private fun prefs() = reactApplicationContext
        .getSharedPreferences(LocationForegroundService.PREFS_NAME, Context.MODE_PRIVATE)

    @ReactMethod
    fun start(apiBase: String, accessToken: String, refreshToken: String, promise: Promise) {
        try {
            prefs().edit()
                .putString(LocationForegroundService.KEY_API_BASE, apiBase)
                .putString(LocationForegroundService.KEY_ACCESS_TOKEN, accessToken)
                .putString(LocationForegroundService.KEY_REFRESH_TOKEN, refreshToken)
                .apply()

            val intent = Intent(reactApplicationContext, LocationForegroundService::class.java)
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                reactApplicationContext.startForegroundService(intent)
            } else {
                reactApplicationContext.startService(intent)
            }
            promise.resolve(true)
        } catch (e: Exception) {
            promise.reject("START_FAILED", e.message, e)
        }
    }

    // Called whenever the JS side's token changes (sign-in, or a successful
    // foreground refresh) so the service's copy stays current — keeping
    // native-side refresh the rare exception rather than the norm, which
    // minimises how often two refreshers could contend for the same
    // single-use refresh token.
    @ReactMethod
    fun updateToken(accessToken: String, refreshToken: String, promise: Promise) {
        prefs().edit()
            .putString(LocationForegroundService.KEY_ACCESS_TOKEN, accessToken)
            .putString(LocationForegroundService.KEY_REFRESH_TOKEN, refreshToken)
            .apply()
        promise.resolve(true)
    }

    @ReactMethod
    fun stop(promise: Promise) {
        try {
            reactApplicationContext.stopService(
                Intent(reactApplicationContext, LocationForegroundService::class.java)
            )
            // Clear the token so a service revived by START_STICKY after
            // sign-out can't keep reporting for a driver who ended their
            // shift — postCurrentLocation() bails without one.
            prefs().edit()
                .remove(LocationForegroundService.KEY_ACCESS_TOKEN)
                .remove(LocationForegroundService.KEY_REFRESH_TOKEN)
                .apply()
            promise.resolve(true)
        } catch (e: Exception) {
            promise.reject("STOP_FAILED", e.message, e)
        }
    }
}

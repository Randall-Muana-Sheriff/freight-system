# Kigali Freight Monorepo - Local Development Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# =============================================================================
# DATABASE (PostgreSQL + PostGIS)
# =============================================================================
DATABASE_URL=postgres://freight:freight@localhost:5432/kigali_freight

# =============================================================================
# REDIS (Optional - for Socket.IO adapter, rate limiting, caching)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# Generate a secure 32+ character secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# Optional: self-signup only ever creates 'driver' accounts, so a fresh
# database has no admin and no way to create one through the API. Set both
# to have the router bootstrap one admin account on migration (a no-op
# once any admin exists). Leave unset to create the first admin manually.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: static bearer token required on GET /metrics (Prometheus scrape
# configs use a static token, not a short-lived user JWT). Leave unset to
# keep /metrics closed.
METRICS_TOKEN=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# =============================================================================
# UI CONFIGURATION (Vite build-time env)
# =============================================================================
VITE_API_BASE_URL=http://localhost:5000

# =============================================================================
# FRONTEND CORS ORIGIN (for development)
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging - Driver App)
# =============================================================================
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# =============================================================================
# OPTIONAL: S3/MinIO (for file uploads - proof of delivery photos, etc.)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=freight-uploads
# S3_ENDPOINT=http://localhost:9000  # For MinIO local

# =============================================================================
# OPTIONAL: TELEGRAM WEBHOOK (Alerts)
# =============================================================================
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# =============================================================================
# OPTIONAL: EMAIL (Nodemailer / SendGrid)
# =============================================================================
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
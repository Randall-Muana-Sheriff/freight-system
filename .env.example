# Inzira Monorepo - Local Development Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL
#
# This file mirrors what docker-compose.yml and the three subprojects'
# own .env.example files actually read. See kigali-freight-router/.env.example
# for the full, authoritative list of backend variables (SMS, push
# notifications, object storage, etc.) — this file covers what you need to
# get docker compose up running locally.

# =============================================================================
# DATABASE (PostgreSQL + PostGIS) — individual vars, not a DATABASE_URL.
# config/appConfig.js in kigali-freight-router reads these separately;
# there is no DATABASE_URL support anywhere in the app.
# =============================================================================
POSTGRES_USER=freight
POSTGRES_PASSWORD=freight

# =============================================================================
# OBJECT STORAGE (MinIO — local S3-compatible stand-in for Cloudflare R2)
# =============================================================================
MINIO_ROOT_USER=freight-minio
MINIO_ROOT_PASSWORD=freight-minio-secret
# Must be reachable from wherever a signed photo/document URL actually gets
# opened (a browser tab, a phone) — not just from this host. Use your
# machine's LAN IP, not "localhost", if the driver app runs on a physical
# device.
R2_PUBLIC_URL_BASE=http://localhost:9000/delivery-photos

# =============================================================================
# AUTHENTICATION (JWT) — required, no insecure default. Generate with:
# openssl rand -base64 48
# =============================================================================
JWT_SECRET=

# Optional: self-signup no longer exists (drivers are invited by phone
# number, staff accounts are created by an existing admin) — set both to
# have bin/migrate.js bootstrap one admin account on first migration run.
# Leave unset to create the first admin manually instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: static bearer token required on GET /metrics. Leave unset to
# keep /metrics closed (404), which is the safe default.
METRICS_TOKEN=

# =============================================================================
# REDIS (optional — enables horizontal scaling; safe single-instance
# in-process fallback when unset)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# UI CONFIGURATION (Vite build-time env — baked into the bundle, not
# runtime-configurable; rebuild the image to change it)
# =============================================================================
VITE_API_BASE_URL=http://localhost:5000

# =============================================================================
# DRIVER APP CONFIGURATION (Expo build-time env)
# =============================================================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# =============================================================================
# OPTIONAL: Africa's Talking (SMS for driver OTP/invite codes). Leave unset
# to have the backend log codes to the console instead of texting them —
# the whole driver auth flow stays testable without a real SMS account.
# =============================================================================
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# =============================================================================
# OPTIONAL: Firebase Cloud Messaging (push notifications to the driver app).
# Path to a service account JSON file, not individual project-id/key
# fields. Leave unset to disable push sending.
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=

# =============================================================================
# OPTIONAL: Telegram webhook (safety/incident alerts to a dispatcher chat)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Geocoding is constrained to the operating market: results outside it are
# wrong answers, not worse ones. countrycodes comes from MARKET_COUNTRY_CODE.
# MARKET_VIEWBOX is west,north,east,south and defaults to Kigali.
MARKET_COUNTRY_CODE=RW
MARKET_VIEWBOX=29.9,-2.05,30.35,-1.8

# ── MTN Mobile Money ──────────────────────────────────────────────────────
# Two products, two subscription keys. Collections pulls money from a
# customer at the door; Disbursements pushes a driver's share back out.
# Leave any of these unset and the feature is simply off: payment requests
# are refused with a message telling the driver to take cash, and no payout
# is ever attempted.
#
# Sandbox settles only in EUR. Production uses the market currency (RWF),
# which has no minor unit — an amount of 15000 is fifteen thousand francs.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=
# Where MTN posts the result. Must be public HTTPS; the reference is
# appended as a path segment so the callback identifies its own transaction.
MOMO_CALLBACK_BASE_URL=https://api.inzira.systems/api/payments/momo/callback
# How long after a customer pays before the driver's transfer is sent, and
# how often the worker looks for due payouts.
DRIVER_PAYOUT_DELAY_MINUTES=5
DRIVER_PAYOUT_TICK_MS=60000

# Monorepo-root-level concerns — each workspace (kigali-freight-*,
# packages/*) has its own .gitignore for its own specifics; this only
# covers what npm workspace hoisting and Turborepo put at the root.
node_modules/
.turbo/
# Backup of kigali-freight-driver's old standalone nested repo (renamed
# aside, not deleted, when this root repo was initialized) — a local
# artifact for reference, not meant to be tracked itself.
kigali-freight-driver/.git.bak-driver-only/
.env
.env.local
*.log
npm-debug.log*
dist/
build/
.DS_Store

# Monorepo-root-level concerns — each workspace (kigali-freight-*,
# packages/*) has its own .gitignore for its own specifics; this only
# covers what npm workspace hoisting and Turborepo put at the root.
node_modules/
.turbo/
# Backup of kigali-freight-driver's old standalone nested repo (renamed
# aside, not deleted, when this root repo was initialized) — a local
# artifact for reference, not meant to be tracked itself.
kigali-freight-driver/.git.bak-driver-only/
.env
.env.local
# Credential files referenced by docker-compose.prod.yml's volume mounts
# (e.g. the Firebase Admin service account) — live only on the deploy
# host, never in the repo.
/secrets/
*.log
npm-debug.log*
dist/
build/
.DS_Store

# ops/backup-db.js writes here when run without an explicit target directory,
# which is what a local restore drill does. On the real host the systemd unit
# passes /var/backups/kigali-freight, so this only ever catches local runs —
# but an untracked dump left here makes the tree dirty and push-to-production
# refuses to deploy, which is a confusing way to discover you took a backup.
kigali-freight-router/backups/

# Regulator source documents kept for reference while pricing is calibrated.
# RURA's tariff scans are multi-megabyte images with no text layer and are
# re-downloadable from rura.rw, so they are not worth carrying in a public
# repo -- and one of them arrived under two different filenames, which is
# exactly the sort of thing that ends up committed twice.
reference/
*.pdf
